# CP-02 local only. Copy to .env.local and use values from supabase status -o env.
# Never put service-role or database secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-key
CP02_FIXTURE_PASSWORD=replace-with-local-synthetic-password
